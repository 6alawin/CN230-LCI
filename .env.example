# For local development, use Render's EXTERNAL URL and add ?sslmode=require.
# For a Render-hosted service, set DATABASE_URL in the Render dashboard to
# the INTERNAL connection URL (private host; no sslmode query parameter).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Set your Gemini API key locally and in Render environment variables
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
